# Copiá este archivo a ".env" (sin el ".example") y completá con los datos
# de tu cuenta gratuita de Cloudinary (Dashboard → Product Environment Credentials).
# Sin esto, la subida de imágenes desde /manage.html no funciona.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional: un PIN que ve y controla las imágenes de TODAS las personas en
# /manage.html y /avanzado.html (los PIN de cada persona se generan solos,
# no hace falta configurarlos acá — ver README, sección "PIN por persona").
ADMIN_PIN=
