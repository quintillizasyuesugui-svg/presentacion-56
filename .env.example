# Copiá este archivo a ".env" (sin el ".example") y completá con los datos
# de tu cuenta gratuita de Cloudinary (Dashboard → Product Environment Credentials).
# Sin esto, la subida de imágenes desde /gestionar.html no funciona.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional: un PIN que ve y controla las imágenes de TODAS las personas en
# /gestionar.html y /avanzado.html (los PIN de cada persona se generan solos,
# no hace falta configurarlos acá — ver README, sección "PIN por persona").
ADMIN_PIN=

# Recomendado: base de datos Postgres (Neon o Supabase, plan gratis). Sin esto se guarda en
# datos/*.json. Ver README, «Base de datos».
DATABASE_URL=

# Recomendado: clave para guardar los PIN cifrados. Cualquier texto largo al azar; en Render,
# botón «Generate». NO cambiarla nunca después (nadie podría entrar).
PIN_SECRETO=

# Opcional: espacio para música y videos. PRESUPUESTO_MB se reparte entre las personas
# registradas, sin bajar de ESPACIO_MIN_MB ni pasar de ESPACIO_MAX_MB (valores en MB).
# CUPO_NUBE_POR_HORA: subidas de música/video por hora (Cloudinary gratis permite ~500).
PRESUPUESTO_MB=12000
ESPACIO_MIN_MB=100
ESPACIO_MAX_MB=2000
CUPO_NUBE_POR_HORA=400
