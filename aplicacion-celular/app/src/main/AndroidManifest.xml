<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Para instalar la versión nueva que baja la propia app (Android pide permiso la primera vez). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Órdenes por voz: el micrófono se pide recién al tocar «🎤 Voz». -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Desde Android 11 hay que declarar que se va a usar el reconocedor de voz del celular. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nombre_app"
        android:theme="@style/Tema"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".Principal"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- El QR de la pantalla abre conexiones://control: si la app está instalada, Android la abre -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="conexiones" android:host="control" />
            </intent-filter>
            <!-- App Link: el QR (https://presentacion-56.onrender.com/celular.html) abre la app directo,
                 sin preguntar; Android lo verifica con /.well-known/assetlinks.json del servidor -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="presentacion-56.onrender.com" android:path="/celular.html" />
            </intent-filter>
        </activity>
    </application>
</manifest>
